+
+namespace MUnique.OpenMU.Network;
+
+using System.Net;
+
+/// <summary>
+/// Selects the bind address for the shared game, connect and chat TCP listener.
+/// This does not configure the admin web host or optional actor endpoint.
+/// </summary>
+internal static class LocalOnlyBinding
+{
+    internal const string EnvironmentVariableName = "OPENMU_LOCAL_ONLY_TCP";
+
+    /// <summary>
+    /// Gets the bind address before a socket is constructed.
+    /// </summary>
+    /// <returns>IPv4 loopback when explicitly enabled; otherwise the legacy wildcard.</returns>
+    /// <exception cref="InvalidOperationException">The option is not unset, 0 or 1.</exception>
+    internal static IPAddress GetAddress()
+    {
+        return Environment.GetEnvironmentVariable(EnvironmentVariableName) switch
+        {
+            null or "0" => IPAddress.Any,
+            "1" => IPAddress.Loopback,
+            _ => throw new InvalidOperationException($"{EnvironmentVariableName} must be unset, 0 or 1."),
+        };
+    }
+}

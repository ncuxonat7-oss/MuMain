<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <Target Name="RequirePatchedSource" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(OpenMuSource)' == ''" Text="Set OpenMuSource to the pinned OpenMU tree with the local bind patch applied." />
  </Target>
  <ItemGroup>
    <Compile Include="$(OpenMuSource)/src/Network/LocalOnlyBinding.cs" Link="LocalOnlyBinding.cs" />
  </ItemGroup>
</Project>
